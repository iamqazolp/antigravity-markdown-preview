{
  "name": "agy-markdown-review",
  "displayName": "Antigravity Document Preview",
  "description": "Google Antigravity's Artifact & Document Preview for Markdown (.md, .mdx, .qmd, .rmd), HTML, SVG, Mermaid, CSV/TSV, and JSONL transcripts — featuring theme-adaptive syntax highlighting, interactive carousels, pan-zoom diagrams, full-bleed PDF/HTML export, and 60fps scroll sync.",
  "version": "1.3.0",
  "publisher": "iamqazolp",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f4f6ff",
    "theme": "light"
  },
  "homepage": "https://github.com/iamqazolp/antigravity-markdown-preview#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamqazolp/antigravity-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/iamqazolp/antigravity-markdown-preview/issues"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Themes",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "antigravity",
    "document-preview",
    "markdown",
    "html",
    "svg",
    "mermaid",
    "csv",
    "jsonl",
    "mdx",
    "quarto",
    "katex",
    "callout",
    "carousel"
  ],
  "scripts": {
    "package": "npx --yes @vscode/vsce package --baseImagesUrl https://raw.githubusercontent.com/iamqazolp/antigravity-markdown-preview/main --baseContentUrl https://github.com/iamqazolp/antigravity-markdown-preview/blob/main",
    "publish": "npx --yes @vscode/vsce publish --baseImagesUrl https://raw.githubusercontent.com/iamqazolp/antigravity-markdown-preview/main --baseContentUrl https://github.com/iamqazolp/antigravity-markdown-preview/blob/main",
    "publish:ovsx": "npx --yes ovsx publish"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onLanguage:html",
    "onLanguage:xml",
    "onLanguage:csv",
    "onLanguage:json",
    "onLanguage:jsonl",
    "onCustomEditor:antigravity.markdownReview"
  ],
  "main": "./extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/antigravity-markdown.css"
    ],
    "markdown.previewScripts": [
      "./media/antigravity-markdown.js"
    ],
    "customEditors": [
      {
        "viewType": "antigravity.markdownReview",
        "displayName": "Antigravity Document Preview",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "**/*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "**/*.markdown"
          },
          {
            "filenamePattern": "*.mdx"
          },
          {
            "filenamePattern": "**/*.mdx"
          },
          {
            "filenamePattern": "*.qmd"
          },
          {
            "filenamePattern": "**/*.qmd"
          },
          {
            "filenamePattern": "*.rmd"
          },
          {
            "filenamePattern": "**/*.rmd"
          },
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "**/*.html"
          },
          {
            "filenamePattern": "*.htm"
          },
          {
            "filenamePattern": "**/*.htm"
          },
          {
            "filenamePattern": "*.svg"
          },
          {
            "filenamePattern": "**/*.svg"
          },
          {
            "filenamePattern": "*.mmd"
          },
          {
            "filenamePattern": "**/*.mmd"
          },
          {
            "filenamePattern": "*.mermaid"
          },
          {
            "filenamePattern": "**/*.mermaid"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "**/*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "**/*.tsv"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "**/*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "**/*.ndjson"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "agyMarkdown.openReview",
        "title": "Antigravity: Open Document Preview",
        "icon": "$(sparkle)"
      },
      {
        "command": "agyMarkdown.openReviewBeside",
        "title": "Antigravity: Open Document Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "agyMarkdown.editSource",
        "title": "Antigravity: Edit Raw Source",
        "icon": "$(edit)"
      },
      {
        "command": "agyMarkdown.openNativeArtifactViewer",
        "title": "Antigravity: Open in Native Artifact Viewer",
        "icon": "$(link-external)"
      },
      {
        "command": "agyMarkdown.syncMpeTheme",
        "title": "Antigravity: Sync Style with Markdown Preview Enhanced"
      },
      {
        "command": "agyMarkdown.toggleSyncScroll",
        "title": "Antigravity: Toggle Synchronized Scrolling (Raw ↔ Preview)"
      },
      {
        "command": "agyMarkdown.exportPdf",
        "title": "Antigravity: Export Document to PDF…",
        "icon": "$(file-pdf)"
      },
      {
        "command": "agyMarkdown.exportPdfThemed",
        "title": "Antigravity: Export Document to PDF (Themed)"
      },
      {
        "command": "agyMarkdown.exportPdfUnthemed",
        "title": "Antigravity: Export Document to PDF (Unthemed)"
      },
      {
        "command": "agyMarkdown.exportHtml",
        "title": "Antigravity: Export Document to Standalone HTML…",
        "icon": "$(globe)"
      },
      {
        "command": "agyMarkdown.exportHtmlThemed",
        "title": "Antigravity: Export Document to Standalone HTML (Themed)"
      },
      {
        "command": "agyMarkdown.exportHtmlUnthemed",
        "title": "Antigravity: Export Document to Standalone HTML (Unthemed)"
      },
      {
        "command": "agyMarkdown.openGitHub",
        "title": "Antigravity: Open GitHub Repository",
        "icon": "$(github)"
      },
      {
        "command": "agyMarkdown.reportIssue",
        "title": "Antigravity: Report Issue on GitHub (with Diagnostics)",
        "icon": "$(bug)"
      },
      {
        "command": "agyMarkdown.showTelemetryStats",
        "title": "Antigravity: Show Extension Telemetry & Marketplace Stats",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agyMarkdown.openReview",
          "when": "(editorLangId == 'markdown' || editorLangId == 'mdx' || editorLangId == 'quarto' || editorLangId == 'rmd' || editorLangId == 'html' || resourceExtname =~ /\\.(md|markdown|mdx|qmd|rmd|html|htm|svg|mmd|mermaid|csv|tsv|jsonl|ndjson)$/i) && activeCustomEditorId != 'antigravity.markdownReview'",
          "group": "navigation@1"
        },
        {
          "command": "agyMarkdown.openReviewBeside",
          "when": "(editorLangId == 'markdown' || editorLangId == 'mdx' || editorLangId == 'quarto' || editorLangId == 'rmd' || editorLangId == 'html' || resourceExtname =~ /\\.(md|markdown|mdx|qmd|rmd|html|htm|svg|mmd|mermaid|csv|tsv|jsonl|ndjson)$/i) && activeCustomEditorId != 'antigravity.markdownReview'",
          "group": "navigation@2"
        },
        {
          "command": "agyMarkdown.editSource",
          "when": "activeCustomEditorId == 'antigravity.markdownReview' || activeCustomEditorId == 'antigravity.artifactEditor'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "agyMarkdown.openReview",
          "when": "resourceExtname =~ /\\.(md|markdown|mdx|qmd|rmd|html|htm|svg|mmd|mermaid|csv|tsv|jsonl|ndjson)$/i",
          "group": "navigation@1"
        },
        {
          "command": "agyMarkdown.openReviewBeside",
          "when": "resourceExtname =~ /\\.(md|markdown|mdx|qmd|rmd|html|htm|svg|mmd|mermaid|csv|tsv|jsonl|ndjson)$/i",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Document Preview",
      "properties": {
        "agyMarkdown.syncScroll": {
          "type": "boolean",
          "default": true,
          "description": "Synchronize scrolling between the raw source editor and Antigravity Document Preview in split edit mode."
        },
        "agyMarkdown.codeLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Display line numbers inside fenced code blocks by default (can also be enabled per block with `showLineNumbers` in the fence info)."
        },
        "agyMarkdown.useThemePalette": {
          "type": "boolean",
          "default": true,
          "description": "Dynamically integrate the active VS Code color theme's workbench surfaces (sidebar/cell tints) and editor syntax token colors into Document Preview."
        },
        "agyMarkdown.syncMarkdownPreviewEnhanced": {
          "type": "boolean",
          "default": true,
          "description": "Automatically apply the Antigravity style and parser extensions to Markdown Preview Enhanced (Crossnote)."
        },
        "agyMarkdown.telemetry": {
          "type": "boolean",
          "default": true,
          "description": "Enable anonymous extension usage and error telemetry (automatically disabled for the extension author and when VS Code telemetry is off)."
        }
      }
    }
  }
}
