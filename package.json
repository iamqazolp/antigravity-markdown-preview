{
  "name": "agy-markdown-review",
  "displayName": "Antigravity Markdown Review",
  "description": "Applies Google Antigravity's Artifact Viewer style (callouts, tables, code blocks, carousels, and file links) to every Markdown review and preview in VS Code.",
  "version": "1.0.0",
  "publisher": "iamqazolp",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f4f6ff",
    "theme": "light"
  },
  "homepage": "https://github.com/iamqazolp/antigravity-markdown-preview#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamqazolp/antigravity-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/iamqazolp/antigravity-markdown-preview/issues"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "antigravity",
    "markdown",
    "preview",
    "review",
    "artifact",
    "syntax-highlighting",
    "mermaid",
    "katex",
    "callout",
    "carousel"
  ],
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onCustomEditor:antigravity.markdownReview"
  ],
  "main": "./extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/antigravity-markdown.css"
    ],
    "markdown.previewScripts": [
      "./media/antigravity-markdown.js"
    ],
    "customEditors": [
      {
        "viewType": "antigravity.markdownReview",
        "displayName": "Antigravity Markdown Review",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "**/*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "agyMarkdown.openReview",
        "title": "Antigravity: Open Markdown Review",
        "icon": "$(sparkle)"
      },
      {
        "command": "agyMarkdown.openReviewBeside",
        "title": "Antigravity: Open Markdown Review to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "agyMarkdown.editSource",
        "title": "Antigravity: Edit Raw Markdown",
        "icon": "$(edit)"
      },
      {
        "command": "agyMarkdown.openNativeArtifactViewer",
        "title": "Antigravity: Open in Native Artifact Viewer",
        "icon": "$(link-external)"
      },
      {
        "command": "agyMarkdown.syncMpeTheme",
        "title": "Antigravity: Sync Style with Markdown Preview Enhanced"
      },
      {
        "command": "agyMarkdown.toggleSyncScroll",
        "title": "Antigravity: Toggle Synchronized Scrolling (Raw ↔ Preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agyMarkdown.openReview",
          "when": "editorLangId == 'markdown' && activeCustomEditorId != 'antigravity.markdownReview'",
          "group": "navigation@1"
        },
        {
          "command": "agyMarkdown.openReviewBeside",
          "when": "editorLangId == 'markdown' && activeCustomEditorId != 'antigravity.markdownReview'",
          "group": "navigation@2"
        },
        {
          "command": "agyMarkdown.editSource",
          "when": "activeCustomEditorId == 'antigravity.markdownReview' || activeCustomEditorId == 'antigravity.artifactEditor'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "agyMarkdown.openReview",
          "when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Markdown Review",
      "properties": {
        "agyMarkdown.syncScroll": {
          "type": "boolean",
          "default": true,
          "description": "Synchronize scrolling between the raw Markdown editor and Antigravity Markdown Review in split edit mode."
        },
        "agyMarkdown.codeLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Display line numbers inside fenced code blocks by default (can also be enabled per block with `showLineNumbers` in the fence info)."
        },
        "agyMarkdown.useThemePalette": {
          "type": "boolean",
          "default": true,
          "description": "Dynamically integrate the active VS Code color theme's workbench surfaces (sidebar/cell tints) and editor syntax token colors into Markdown Review and previews."
        },
        "agyMarkdown.syncMarkdownPreviewEnhanced": {
          "type": "boolean",
          "default": true,
          "description": "Automatically apply the Antigravity style and parser extensions to Markdown Preview Enhanced (Crossnote)."
        }
      }
    }
  }
}
